<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup is disabled in the manifest (allowBackup=false).
  These excludes remain as defense-in-depth if backup is ever re-enabled.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
